{
  "name": "MessBuddy",
  "short_name": "MessBuddy",
  "description": "Campus meal discovery for students and daily menu publishing for vendors.",
  "start_url": "/welcome.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fffaf6",
  "theme_color": "#d3482f",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
